{
  "name": "sgcc-crypto-api",
  "version": "1.0.0",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "build:win": "pkg . --targets node18-win-x64 --output dist/sgcc-crypto-api-win.exe",
    "build:linux-x64": "pkg . --targets node18-linux-x64 --output dist/sgcc-crypto-api-linux-x64",
    "build:linux-arm64": "pkg . --targets node18-linux-arm64 --output dist/sgcc-crypto-api-linux-arm64",
    "build:all": "pkg . --targets node18-win-x64,node18-linux-x64,node18-linux-arm64 --out-path dist"
  },
  "pkg": {
    "assets": [
      "node_modules/sm-crypto/**/*"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "express": "^4.18.0",
    "sm-crypto": "^0.3.13",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.11.0"
  }
}
